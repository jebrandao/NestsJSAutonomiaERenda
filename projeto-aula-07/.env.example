# Local (MongoDB Community Server instalado nesta máquina, sem autenticação):
DATABASE_URL=mongodb://localhost:27017/backend-nestjs-aula18

# Produção/Atlas (exemplo de formato, nunca commitar a URI real):
# DATABASE_URL=mongodb+srv://usuario:senha@cluster.mongodb.net/nomeDoBanco

# Aula 30: chave usada para assinar/validar os JWT emitidos no login.
# Gere a sua com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nunca reutilize um valor de exemplo em produção.
JWT_SECRET=troque-por-um-valor-aleatorio-gerado-localmente

# Aula 33: chave separada para o Refresh Token — nunca a mesma do JWT_SECRET.
# Isola o access token do refresh token: um vazamento de uma chave não
# compromete automaticamente o outro tipo de token.
JWT_REFRESH_SECRET=troque-por-outro-valor-aleatorio-gerado-localmente
